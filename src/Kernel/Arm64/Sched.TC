//ARM64 version of the asm in $LK,"Sched",A="FI:::/Kernel/Sched.TC"$: task switching.
//
//Same scheduler as x86: a round-robin walk of the core's task queue,
//skipping tasks that are waiting for a message, suspended or asleep until
//a later jiffy. Fs (the current CTask) is in TPIDR_EL1 and Gs (the
//current CCPU) in TPIDRRO_EL0. The CTask register slots hold the ARM64
//registers the x86 ones map to: rax..r15 are X0..X15 (rsi X6, rdi X7),
//rbp is X29, rsp is SP, rip is the resume address. rflags keeps the x86
//format (bit 9 set: interrupts on), see $LK,"GetRFlags",A="MN:GetRFlags"$.
//
//Not done yet on ARM64: the <CTRL-ALT-key> events (there's no keyboard
//driver yet), breakpoints and saving FP/SIMD registers (TerryC code
//keeps no FP values in registers across a call, so Yield needs none).
//X6 plays the part of x86 RSI: the task being looked at. X7 holds the
//jiffies count while a task is chosen (its own X7 is saved by then).

I64 ArmJiffiesUpdate()
{//Until the timer interrupt is converted, jiffies come from the generic
//timer: called on every task switch and while idle. Returns jiffies.
  I64 frq=ArmCntFrq,t;
  if (frq) {
    t=ArmCntPct;
    cnts.jiffies=t/frq*JIFFY_FREQ+t%frq*JIFFY_FREQ/frq;
  }
  return cnts.jiffies;
}

I64 ArmIdle()
{//Nothing is ready to run. Returns jiffies.
  PAUSE
  return ArmJiffiesUpdate;
}

asm {
//A new task starts here (see $LK,"Spawn",A="MN:Spawn"$): X1=start address,
//[SP]=&Exit (its return address) and [SP+8]=its data arg.
ARM64_TASK_START::
	LDR	X30,[SP],8
	BR	X1

_YIELD::
	ADR	X16,SYS_SEMAS
	LDRB	W16,[X16,SEMA_SINGLE_USER*DFT_CACHE_LINE_WIDTH]
	TBZ	W16,0,@@05
	RET		//If single user, don't change task.
@@05:	MRS	X17,DAIF
	MSR	DAIFSET,3
	MRS	X16,TPIDR_EL1
	STR	X30,[X16,CTask.rip]	//Resume where Yield returns to
	UBFX	X17,X17,7,1		//rflags: x86 format, IF=!DAIF.I
	LSL	X17,X17,9
	MOV	X0,0x202
	SUB	X0,X0,X17
	STR	X0,[X16,CTask.rflags]
	MOV	X0,SP
	STR	X0,[X16,CTask.rsp]
	STR	X6,[X16,CTask.rsi]	//The registers callees must keep
	STR	X7,[X16,CTask.rdi]
	STR	X29,[X16,CTask.rbp]
	STR	X10,[X16,CTask.r10]
	STR	X11,[X16,CTask.r11]
	STR	X12,[X16,CTask.r12]
	STR	X13,[X16,CTask.r13]
	STR	X14,[X16,CTask.r14]
	STR	X15,[X16,CTask.r15]
	LDR	X6,[X16,CTask.next_task]

RESTORE_RSI_TASK::
	BL	&ArmJiffiesUpdate
	MOV	X7,X0			//X7=jiffies while choosing a task
RESTORE_RSI_TASK2::
	LDR	X0,[X6,CTask.task_flags]
	TBNZ	X0,TASKf_KILL_TASK,END_RSI_TASK
	MOV	X1,1<<TASKf_AWAITING_MSG|1<<TASKf_SUSPENDED
	TST	X0,X1
	BNE	@@25
	LDR	X2,[X6,CTask.wake_jiffy]
	CMP	X2,X7
	BGT	@@25			//Not ready yet
	MSR	TPIDR_EL1,X6
	B	_TASK_CONTEXT_RESTORE

@@25:	LDR	X6,[X6,CTask.next_task]
	MRS	X0,TPIDRRO_EL0		//Gs
	LDR	X1,[X0,CCPU.seth_task]
	CMP	X1,X6
	BNE	RESTORE_RSI_TASK2	//Not back at Seth yet
	LDR	X2,[X0,CCPU.cpu_flags]
	TBZ	X2,CPUf_RAN_A_TASK,@@30
	MOV	X3,1<<CPUf_RAN_A_TASK
	BIC	X2,X2,X3
	STR	X2,[X0,CCPU.cpu_flags]
	B	RESTORE_RSI_TASK2	//Had a chance to run, go around again

@@30:	LDR	X1,[X0,CCPU.idle_task]	//Nothing ready: idle
	CBZ	X1,@@35
	LDR	X2,[X1,CTask.stk]
	MOV	X3,MEM_DFT_STK+CTaskStk.stk_base
	ADD	X2,X2,X3
	MOV	SP,X2
	MSR	TPIDR_EL1,X1
@@35:	BL	&ArmIdle
SYS_IDLE_PT::
	MOV	X7,X0
	MRS	X0,TPIDRRO_EL0
	LDR	X6,[X0,CCPU.seth_task]
	B	RESTORE_RSI_TASK2

END_RSI_TASK::
	MSR	TPIDR_EL1,X6
_TASK_END_NOW::
	BL	TaskEnd
	MOV	X6,X0
	MSR	TPIDR_EL1,X6
	B	RESTORE_RSI_TASK

//************************************
_TASK_CONTEXT_RESTORE::	//Switch to Fs
	MRS	X6,TPIDR_EL1
	MRS	X0,TPIDRRO_EL0
	LDR	X1,[X0,CCPU.swap_cnter]
	ADD	X1,X1,1
	STR	X1,[X0,CCPU.swap_cnter]
	LDR	X2,[X6,CTask.rflags]
	TBZ	X2,RFLAGf_INT,@@05
	LDR	X1,[X0,CCPU.cpu_flags]
	MOV	X3,1<<CPUf_RAN_A_TASK
	ORR	X1,X1,X3
	STR	X1,[X0,CCPU.cpu_flags]
@@05:	LDR	X1,[X6,CTask.swap_cnter]
	ADD	X1,X1,1
	STR	X1,[X6,CTask.swap_cnter]

	LDR	X0,[X6,CTask.rsp]
	MOV	SP,X0
	LDR	X0,[X6,CTask.rax]
	LDR	X1,[X6,CTask.rcx]
	LDR	X2,[X6,CTask.rdx]
	LDR	X3,[X6,CTask.rbx]
	LDR	X7,[X6,CTask.rdi]
	LDR	X8,[X6,CTask.r8]
	LDR	X9,[X6,CTask.r9]
	LDR	X10,[X6,CTask.r10]
	LDR	X11,[X6,CTask.r11]
	LDR	X12,[X6,CTask.r12]
	LDR	X13,[X6,CTask.r13]
	LDR	X14,[X6,CTask.r14]
	LDR	X15,[X6,CTask.r15]
	LDR	X29,[X6,CTask.rbp]
	LDR	X16,[X6,CTask.rip]
	LDR	X17,[X6,CTask.rflags]	//x86 IF -> DAIF.I and DAIF.F
	UBFX	X17,X17,9,1
	EOR	X17,X17,1
	LSL	X17,X17,6
	ORR	X17,X17,X17,LSL 1
	MSR	DAIF,X17
	LDR	X6,[X6,CTask.rsi]
	BR	X16
}


_extern ARM64_TASK_START U8 arm64_task_start; //See $LK,"Spawn",A="MN:Spawn"$
