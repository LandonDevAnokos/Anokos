//ARM64 kernel main: continued from $LK,"KStart",A="FF:::/Kernel/Arm64/KStart.TC,KMainArm64"$.
//
//This is the ARM64 counterpart of $LK,"KMain",A="MN:KMain"$ and grows toward it as more of the
//kernel is converted. Right now it brings up the board and the serial
//console, checks the code the ARM64 compiler back end makes, and runs a
//small serial monitor.

U0 ArmBanner()
{
  I64 midr=ArmMidr;
  ArmSerPutS("\nAnokos ARM64 kernel (TempleOS V5.03 base)\n");
  ArmSerPutS("Board:   ");
  ArmSerPutS(arm_board.name);
  ArmSerPutS("\nCPU:     MIDR ");
  ArmSerPutHex(midr,8);
  switch (midr>>4&0xFFF) {
    case 0xD03: ArmSerPutS(" Cortex-A53"); break;
    case 0xD07: ArmSerPutS(" Cortex-A57"); break;
    case 0xD08: ArmSerPutS(" Cortex-A72"); break;
    case 0xD0B: ArmSerPutS(" Cortex-A76"); break;
    case 0x000: ArmSerPutS(" (QEMU max)"); break;
  }
  ArmSerPutS("\nEL:      entered at EL");
  ArmSerPutDec(arm64_boot_el);
  ArmSerPutS(", running at EL");
  ArmSerPutDec(ArmCurEl);
  ArmSerPutS("\nImage:   loaded at ");
  ArmSerPutHex(arm64_load_base);
  ArmSerPutS("\nDTB:     ");
  if (arm64_dtb)
    ArmSerPutHex(arm64_dtb);
  else
    ArmSerPutS("none");
  ArmSerPutS("\nSCTLR:   ");
  ArmSerPutHex(ArmSctlr,8);
  ArmSerPutS(" (MMU ");
  if (ArmSctlr&1)
    ArmSerPutS("on)");
  else
    ArmSerPutS("off)");
  ArmSerPutS("\nTimer:   ");
  ArmSerPutDec(ArmCntFrq);
  ArmSerPutS(" Hz\n");
}

//************************************
//Back end self test: a few things the code generator must get right.
I64 arm_test_glbl=5;
I64 arm_test_tbl[4]={10,20,30,40};
U8 *arm_test_strs[3]={"zero","one","two"};

class CArmTest
{
  U8	a;
  I64	b; //Unaligned: TerryC classes are packed
  U16	c;
};

I64 ArmTestFib(I64 n)
{
  if (n<2) return n;
  return ArmTestFib(n-1)+ArmTestFib(n-2);
}

I64 ArmTestSwitch(I64 n)
{
  switch (n) {
    case 0: return 100;
    case 1: return 101;
    case 2: return 102;
    case 3...5: return 105;
    case 7: return 107;
  }
  return -1;
}

I64 ArmTestVarArgs(I64 first,...)
{
  I64 i,res=first;
  for (i=0;i<argc;i++)
    res+=argv[i];
  return res;
}

I64 ArmTest(U8 *name,I64 got,I64 want)
{
  if (got!=want) {
    ArmSerPutS("  FAIL ");
    ArmSerPutS(name);
    ArmSerPutS(": got ");
    ArmSerPutDec(got);
    ArmSerPutS(", want ");
    ArmSerPutDec(want);
    ArmSerPutS("\n");
    return 1;
  }
  return 0;
}

I64 ArmSelfTest()
{//Returns number of failures.
  I64 fails=0,i,j,*p;
  U8 buf[16];
  CArmTest t;
  F64 d;
  U64 u;

  fails+=ArmTest("Fib",ArmTestFib(20),6765);
  fails+=ArmTest("glbl",arm_test_glbl,5);
  arm_test_glbl+=7;
  fails+=ArmTest("glbl+=",arm_test_glbl,12);
  fails+=ArmTest("tbl",arm_test_tbl[2],30);
  fails+=ArmTest("str ptr",arm_test_strs[1][1],'n');
  j=0;
  for (i=0;i<10;i++)
    j+=i*i;
  fails+=ArmTest("loop",j,285);
  fails+=ArmTest("switch",ArmTestSwitch(4),105);
  fails+=ArmTest("switch dft",ArmTestSwitch(6),-1);
  fails+=ArmTest("varargs",ArmTestVarArgs(1,2,3,4),10);
  i=-17;
  fails+=ArmTest("div",i/5,-3);
  fails+=ArmTest("mod",i%5,-2);
  u=17;
  fails+=ArmTest("udiv",u/5,3);
  fails+=ArmTest("shr",i>>2,-5);
  fails+=ArmTest("shl",i<<3,-136);
  fails+=ArmTest("cmp chain",ToI64(1<i+20<5),1);
  t.a=1;
  t.b=0x123456789;
  t.c=0xBEEF;
  fails+=ArmTest("unaligned",t.b,0x123456789);
  fails+=ArmTest("U16",t.c,0xBEEF);
  t.a=255;
  t.a++;
  fails+=ArmTest("U8 wrap",t.a,0);
  i=0;
  fails+=ArmTest("Bts",Bts(&i,40),0);
  fails+=ArmTest("Bt",Bt(&i,40),1);
  fails+=ArmTest("bit val",i,1<<40);
  StrCpy(buf,"ARM64");
  fails+=ArmTest("StrLen",StrLen(buf),5);
  fails+=ArmTest("StrCmp",StrCmp(buf,"ARM65"),-1);
  fails+=ArmTest("StrICmp",StrICmp(buf,"arm64"),0);
  MemSet(buf,'x',3);
  fails+=ArmTest("MemSet",buf[2],'x');
  fails+=ArmTest("MemCmp",MemCmp(buf,"xxx64",5),0);
  fails+=ArmTest("ToUpper",ToUpper('q'),'Q');
  p=&j;
  *p=42;
  fails+=ArmTest("ptr",j,42);
  fails+=ArmTest("Min",MinI64(-3,7),-3);
  fails+=ArmTest("Max",MaxU64(3,7),7);
  d=1.5;
  d=d*4.0+0.5;
  fails+=ArmTest("F64",ToI64(d*10),65);
  fails+=ArmTest("F64 cmp",d>6.0,1);
  return fails;
}

//************************************
U0 ArmMonitor()
{//Tiny serial monitor until the real command line runs on ARM64.
  I64 ch;
  ArmSerPutS("\nSerial monitor: h help, r reboot, o power off, t self test\n> ");
  while (TRUE) {
    if ((ch=ArmSerGetChar)<0)
      goto mon_next;
    ArmSerPutChar(ch);
    switch (ch) {
      case 'h':
	ArmSerPutS("\nh help  r reboot  o power off  t self test  i info\n");
	break;
      case 'r':
	ArmSerPutS("\nRebooting\n");
	ArmReboot;
	break;
      case 'o':
	ArmSerPutS("\nPower off\n");
	ArmPowerOff;
	break;
      case 't':
	ArmSerPutS("\nSelf test: ");
	ArmSerPutDec(ArmSelfTest);
	ArmSerPutS(" failures\n");
	break;
      case 'i':
	ArmBanner;
	break;
      case '\r':
	ArmSerPutS("\n");
	break;
      default:
	goto mon_next;
    }
    ArmSerPutS("> ");
mon_next:
  }
}

U0 KMainArm64(U8 *dtb)
{//Continued from $LK,"KStart",A="FF:::/Kernel/Arm64/KStart.TC,KMainArm64"$
  I64 fails;
  no_warn dtb;
  ArmBoardInit;
  ArmSerInit;
  ArmBanner;
  ArmSerPutS("Compiler self test: ");
  fails=ArmSelfTest;
  if (fails)
    ArmSerPutS("FAILED\n");
  else
    ArmSerPutS("all passed\n");
  ArmSerPutS("@@ARM64 BOOT OK\n");
  ArmMonitor;
}
