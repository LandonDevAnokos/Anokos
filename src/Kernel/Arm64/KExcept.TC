//ARM64 version of the asm in $LK,"KExcept",A="FI:::/Kernel/KExcept.TC"$: try/catch support.
//The registers a try saves are the ones TerryC callees keep. On ARM64
//they are X6, X7, X10-X15 (x86 RSI, RDI, R10-R15) and X29 (RBP).

asm {
_TEST_EXCEPT::	//Run the catch block of the innermost try.
//Catch blocks end with a stack-popping return (like x86 RET), so push
//our return address for them to come back to $LK,"throw",A="MN:throw"$.
	STR	X30,[SP,-8]!
	MRS	X0,TPIDR_EL1
	LDR	X0,[X0,CTask.last_except]
	LDR	X29,[X0,CExcept.rbp]
	LDR	X6,[X0,CExcept.rsi]
	LDR	X7,[X0,CExcept.rdi]
	LDR	X10,[X0,CExcept.r10]
	LDR	X11,[X0,CExcept.r11]
	LDR	X12,[X0,CExcept.r12]
	LDR	X13,[X0,CExcept.r13]
	LDR	X14,[X0,CExcept.r14]
	LDR	X15,[X0,CExcept.r15]
	LDR	X16,[X0,CExcept.rflags]	//x86 IF -> DAIF.I and DAIF.F
	UBFX	X16,X16,9,1
	EOR	X16,X16,1
	LSL	X16,X16,6
	ORR	X16,X16,X16,LSL 1
	MSR	DAIF,X16
	LDR	X16,[X0,CExcept.hndlr_catch]
	BR	X16

_TAKE_EXCEPT::	//Continue after the try/catch.
	MRS	X0,TPIDR_EL1
	LDR	X0,[X0,CTask.last_except]
	LDR	X1,[X0,CExcept.rsp]
	MOV	SP,X1
	LDR	X16,[X0,CExcept.hndlr_untry]
	BR	X16

_SAVE_EXCEPT_REGS::	//U0 SaveExceptRegs(CExcept *t)
	LDR	X0,[SP]
	ADD	SP,SP,8
	STR	X6,[X0,CExcept.rsi]
	STR	X7,[X0,CExcept.rdi]
	STR	X10,[X0,CExcept.r10]
	STR	X11,[X0,CExcept.r11]
	STR	X12,[X0,CExcept.r12]
	STR	X13,[X0,CExcept.r13]
	STR	X14,[X0,CExcept.r14]
	STR	X15,[X0,CExcept.r15]
	RET
}
