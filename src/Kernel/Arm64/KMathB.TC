//ARM64: TerryC versions of the $LK,"KMathA",A="FI:::/Kernel/KMathA.TC"$ routines x86 does with x87
//instructions. $LK,"Arm64/KMathA",A="FI:::/Kernel/Arm64/KMathA.TC"$ branches here from the original labels,
//so callers use the usual names (Exp, Ln, Pow, D3Add...).

F64 ArmLdExp(F64 x,I64 e)
{//x*2^e
  F64 f;
  while (e>1000) {
    x*=0x7E70000000000000(F64); //2^1000
    e-=1000;
  }
  while (e<-1000) {
    x*=0x0170000000000000(F64); //2^-1000
    e+=1000;
  }
  f(I64)=(e+1023)<<52;
  return x*f;
}

F64 ArmExp(F64 x)
{//e^x: x=k*ln2+r with |r|<=ln2/2, then a Taylor series for e^r.
  I64 i,k;
  F64 r,sum,term;
  if (x!=x) return x;
  if (x>709.8) return inf;
  if (x<-745.2) return 0.0;
  k=ToI64(Round(x/loge_2));
  r=x-k*loge_2;
  sum=1.0;
  term=1.0;
  for (i=1;i<=18;i++) {
    term*=r/i;
    sum+=term;
  }
  return ArmLdExp(sum,k);
}

F64 ArmLn(F64 x)
{//ln x=e*ln2+ln m, m in [sqrt(1/2),sqrt(2)), ln m=2*atanh((m-1)/(m+1)).
  I64 bits,e,i;
  F64 m,s,s2,term,sum;
  if (x!=x || x<0.0) return 0x7FF8000000000000(F64); //NaN
  if (x==0.0) return -inf;
  if (x==inf) return inf;
  e=0;
  if (x<0x0010000000000000(F64)) {//Denormal
    x*=0x4350000000000000(F64); //2^54
    e=-54;
  }
  bits=x(I64);
  e+=(bits>>52&0x7FF)-1023;
  bits=bits&0x000FFFFFFFFFFFFF|0x3FF0000000000000;
  m=bits(F64);
  if (m>sqrt2) {
    m/=2.0;
    e++;
  }
  s=(m-1.0)/(m+1.0);
  s2=s*s;
  term=s;
  sum=0.0;
  for (i=1;i<=41;i+=2) {
    sum+=term/i;
    term*=s2;
  }
  return e*loge_2+2.0*sum;
}

F64 ArmLog2(F64 x)
{
  return ArmLn(x)*log2_e;
}

F64 ArmLog10(F64 x)
{
  return ArmLn(x)*log2_e*log10_2;
}

F64 ArmPowI(F64 base,I64 n)
{//base^n by squaring, exact while the result fits.
  F64 res=1.0;
  Bool neg=FALSE;
  if (n<0) {
    neg=TRUE;
    n=-n;
  }
  while (n) {
    if (n&1)
      res*=base;
    base*=base;
    n>>=1;
  }
  if (neg)
    return 1.0/res;
  return res;
}

F64 ArmPow(F64 base,F64 power)
{
  I64 n;
  F64 res;
  if (power==0.0) return 1.0;
  if (base!=base || power!=power) return 0x7FF8000000000000(F64);
  if (Floor(power)==power && -1024.0<power<1024.0)
    return ArmPowI(base,ToI64(power));
  if (base==0.0) {
    if (power>0.0) return 0.0;
    return inf;
  }
  if (base<0.0) {
    if (Floor(power)!=power) return 0x7FF8000000000000(F64);
    n=ToI64(Floor(power/2.0)*2.0);
    res=ArmExp(power*ArmLn(-base));
    if (n!=ToI64(power))
      return -res;
    return res;
  }
  return ArmExp(power*ArmLn(base));
}

F64 ArmPow10(F64 d)
{
  return ArmPow(10.0,d);
}

F64 ArmATan(F64 z)
{//atan z. Halve the angle twice, then a Taylor series.
  I64 i;
  F64 s,z2,term,sum,res;
  Bool neg=FALSE,inv=FALSE;
  if (z!=z) return z;
  if (z<0.0) {
    neg=TRUE;
    z=-z;
  }
  if (z>1.0) {
    inv=TRUE;
    z=1.0/z;
  }
  z=z/(1.0+Sqrt(1.0+z*z));
  z=z/(1.0+Sqrt(1.0+z*z));
  z2=z*z;
  term=z;
  sum=0.0;
  s=1.0;
  for (i=1;i<=29;i+=2) {
    sum+=s*term/i;
    term*=z2;
    s=-s;
  }
  res=4.0*sum;
  if (inv)
    res=pi/2.0-res;
  if (neg)
    return -res;
  return res;
}

F64 ArmArg(F64 x,F64 y)
{//Polar angle of (x,y), like x87 FPATAN: atan2(y,x).
  F64 res;
  if (x==0.0) {
    if (y>0.0) return pi/2.0;
    if (y<0.0) return -pi/2.0;
    return 0.0;
  }
  res=ArmATan(y/x);
  if (x<0.0) {
    if (y<0.0)
      return res-pi;
    return res+pi;
  }
  return res;
}

//D3 vector ops
F64 ArmD3NormSqr(CD3 *d)
{
  return d->x*d->x+d->y*d->y+d->z*d->z;
}

F64 ArmD3Norm(CD3 *d)
{
  return Sqrt(d->x*d->x+d->y*d->y+d->z*d->z);
}

F64 ArmD3DistSqr(CD3 *d1,CD3 *d2)
{
  F64 dx=d1->x-d2->x,dy=d1->y-d2->y,dz=d1->z-d2->z;
  return dx*dx+dy*dy+dz*dz;
}

F64 ArmD3Dist(CD3 *d1,CD3 *d2)
{
  return Sqrt(ArmD3DistSqr(d1,d2));
}

CD3 *ArmD3Cross(CD3 *prod,CD3 *d1,CD3 *d2)
{
  F64 x=d1->y*d2->z-d1->z*d2->y,
	y=d1->z*d2->x-d1->x*d2->z,
	z=d1->x*d2->y-d1->y*d2->x;
  prod->x=x;
  prod->y=y;
  prod->z=z;
  return prod;
}

F64 ArmD3Dot(CD3 *d1,CD3 *d2)
{
  return d1->x*d2->x+d1->y*d2->y+d1->z*d2->z;
}

CD3 *ArmD3Add(CD3 *sum,CD3 *d1,CD3 *d2)
{
  sum->x=d1->x+d2->x;
  sum->y=d1->y+d2->y;
  sum->z=d1->z+d2->z;
  return sum;
}

CD3 *ArmD3Sub(CD3 *diff,CD3 *d1,CD3 *d2)
{
  diff->x=d1->x-d2->x;
  diff->y=d1->y-d2->y;
  diff->z=d1->z-d2->z;
  return diff;
}

CD3 *ArmD3Mul(CD3 *prod,F64 s,CD3 *d)
{
  prod->x=s*d->x;
  prod->y=s*d->y;
  prod->z=s*d->z;
  return prod;
}

CD3 *ArmD3Div(CD3 *quot,CD3 *d,F64 s)
{
  quot->x=d->x/s;
  quot->y=d->y/s;
  quot->z=d->z/s;
  return quot;
}

CD3 *ArmD3Zero(CD3 *dst)
{
  dst->x=0.0;
  dst->y=0.0;
  dst->z=0.0;
  return dst;
}

CD3 *ArmD3Copy(CD3 *dst,CD3 *src)
{
  dst->x=src->x;
  dst->y=src->y;
  dst->z=src->z;
  return dst;
}

CD3 *ArmD3Equ(CD3 *d,F64 x=0,F64 y=0,F64 z=0)
{
  d->x=x;
  d->y=y;
  d->z=z;
  return d;
}

CD3 *ArmD3AddEqu(CD3 *sum,CD3 *d)
{
  sum->x+=d->x;
  sum->y+=d->y;
  sum->z+=d->z;
  return sum;
}

CD3 *ArmD3SubEqu(CD3 *diff,CD3 *d)
{
  diff->x-=d->x;
  diff->y-=d->y;
  diff->z-=d->z;
  return diff;
}

CD3 *ArmD3MulEqu(CD3 *prod,F64 s)
{
  prod->x*=s;
  prod->y*=s;
  prod->z*=s;
  return prod;
}

CD3 *ArmD3DivEqu(CD3 *quot,F64 s)
{
  quot->x/=s;
  quot->y/=s;
  quot->z/=s;
  return quot;
}

CD3 *ArmD3Unit(CD3 *d)
{
  F64 n=ArmD3Norm(d);
  if (n) {
    d->x/=n;
    d->y/=n;
    d->z/=n;
  }
  return d;
}
