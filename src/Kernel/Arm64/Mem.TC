//ARM64 memory bring-up: what the BIOS memory map and KStart32's
//SYS_INIT_16MEG_SYS_CODE_BP do on x86.
//
//RAM comes from the device tree's /memory nodes (QEMU, Pi firmware) or,
//on a Raspberry Pi without one, from the VideoCore mailbox. It goes into
//the same MEM_E820 table the x86 BIOS fills, so $LK,"BIOSTotalMem",A="MN:BIOSTotalMem"$() and
//$LK,"Mem32DevInit",A="MN:Mem32DevInit"$() work unchanged. The code heap starts after the image:
//the first 16 MiB go to sys_code_bp now (like x86's low 16 MiB) and
//$LK,"BlkPoolsInit",A="MN:BlkPoolsInit"$() adds the rest once Adam's task exists.

#define ARM_BOOT_HEAP_SIZE	0x1000000

U8 *arm_heap_start,	//First byte the heaps may use (after the image)
   *arm_heap_end;	//End of the RAM range holding the image

U32 ArmBe32(U8 *p)
{//Device trees are big-endian.
  return p[0]<<24|p[1]<<16|p[2]<<8|p[3];
}

Bool ArmFdtValid(U8 *fdt)
{
  return fdt && !(fdt&3) && ArmBe32(fdt)==0xD00DFEED &&
	ArmBe32(fdt+20)>=16;
}

I64 ArmFdtSize(U8 *fdt)
{
  if (ArmFdtValid(fdt))
    return ArmBe32(fdt+4);
  return 0;
}

U8 *ArmFdtProp(U8 *fdt,U8 *node_path,U8 *prop,I64 *_len=NULL)
{//Find a property of a node directly under the root ("" for the root).
  U8 *s=fdt+ArmBe32(fdt+8),*strs=fdt+ArmBe32(fdt+12),*name;
  I64 tok,depth=0,len;
  Bool in_node=FALSE;
  while (TRUE) {
    tok=ArmBe32(s);
    s+=4;
    switch (tok) {
      case 1: //BEGIN_NODE
	name=s;
	depth++;
	if (depth==1)
	  in_node=!*node_path;
	else if (depth==2)
	  in_node=!StrCmp(name,node_path) ||
		!StrNCmp(name,node_path,StrLen(node_path)) &&
		name[StrLen(node_path)]=='@';
	else
	  in_node=FALSE;
	s+=(StrLen(name)+1+3)&~3;
	break;
      case 2: //END_NODE
	depth--;
	in_node=depth==1 && !*node_path;
	break;
      case 3: //PROP
	len=ArmBe32(s);
	if (in_node && !StrCmp(strs+ArmBe32(s+4),prop)) {
	  if (_len) *_len=len;
	  return s+8;
	}
	s+=8+(len+3)&~3;
	break;
      case 4: //NOP
	break;
      default: //END
	return NULL;
    }
  }
}

I64 ArmFdtMem(U8 *fdt,CMemE820 *m20,I64 max)
{//Fill m20 with the /memory@... ranges. Returns the count.
  U8 *s=fdt+ArmBe32(fdt+8),*strs=fdt+ArmBe32(fdt+12),*p,*name;
  I64 tok,depth=0,len,ac=2,sc=1,i,cnt=0,base,size;
  Bool in_mem=FALSE;
  while (TRUE) {
    tok=ArmBe32(s);
    s+=4;
    switch (tok) {
      case 1:
	name=s;
	depth++;
	if (depth==2 && !StrNCmp(name,"memory",6))
	  in_mem=TRUE;
	s+=(StrLen(name)+1+3)&~3;
	break;
      case 2:
	if (depth==2)
	  in_mem=FALSE;
	depth--;
	break;
      case 3:
	len=ArmBe32(s);
	p=s+8;
	name=strs+ArmBe32(s+4);
	if (depth==1) {
	  if (!StrCmp(name,"#address-cells")) ac=ArmBe32(p);
	  if (!StrCmp(name,"#size-cells")) sc=ArmBe32(p);
	} else if (in_mem && depth==2 && !StrCmp(name,"reg")) {
	  while (len>=(ac+sc)*4 && cnt<max) {
	    base=0;
	    for (i=0;i<ac;i++)
	      base=base<<32|ArmBe32(p+i*4);
	    size=0;
	    for (i=0;i<sc;i++)
	      size=size<<32|ArmBe32(p+(ac+i)*4);
	    p+=(ac+sc)*4;
	    len-=(ac+sc)*4;
	    if (size) {
	      m20[cnt].base=base;
	      m20[cnt].len=size;
	      m20[cnt].type=1;
	      cnt++;
	    }
	  }
	}
	s+=8+(len+3)&~3;
	break;
      case 4:
	break;
      default:
	return cnt;
    }
  }
}

U8 arm_mbox_raw[256];

Bool ArmMboxCall(U32 *buf)
{//VideoCore mailbox property call (Raspberry Pi). buf: 16-byte aligned.
  U8 *b=arm_board.mbox_base;
  U32 *status,*wr,*rd,r;
  if (!b || buf(I64)&15 || buf(I64)>>32)
    return FALSE;
  status=b+0x18;
  wr=b+0x20;
  rd=b;
  ArmDCacheFlush(buf,buf[0]);
  while (*status&0x80000000) {}
  *wr=buf(I64)|8;
  while (TRUE) {
    while (*status&0x40000000) {}
    r=*rd;
    if (r&15==8 && r&~15==buf(I64))
      break;
  }
  ArmDCacheFlush(buf,buf[0]);
  return buf[1]==0x80000000;
}

I64 ArmMboxMem(CMemE820 *m20)
{//ARM memory from the mailbox (GET_ARM_MEMORY): one range.
  U32 *buf=(arm_mbox_raw+15)&~15;
  MemSet(buf,0,32);
  buf[0]=8*4;
  buf[2]=0x00010005;
  buf[3]=8;
  if (!ArmMboxCall(buf) || !buf[6])
    return 0;
  m20->base=buf[5];
  m20->len=buf[6];
  m20->type=1;
  return 1;
}

U0 ArmMemDefault(CMemE820 *m20)
{//No device tree and no mailbox answer: assume the smallest board.
  m20->type=1;
  if (arm_board.num==BOARD_QEMU_VIRT) {
    m20->base=0x40000000;
    m20->len=0x20000000;
  } else {
    m20->base=0;
    m20->len=0x3C000000;
  }
}

U0 ArmMemInit()
{//Find RAM and give the boot code heap its first block of it.
  CMemE820 *m20=MEM_E820;
  I64 i,cnt=0,img_end,top=0;
  CBlkPool *bp;
  U8 *m;

  MemSet(m20,0,MEM_E820_ENTRIES_NUM*sizeof(CMemE820));
  if (ArmFdtValid(arm64_dtb))
    cnt=ArmFdtMem(arm64_dtb,m20,MEM_E820_ENTRIES_NUM-1);
  if (!cnt && arm_board.mbox_base)
    cnt=ArmMboxMem(m20);
  if (!cnt) {
    ArmMemDefault(m20);
    cnt=1;
  }

//The image and its reserved area (boot stack) come first.
  img_end=arm64_load_base+arm64_image_size;
  img_end=(img_end+MEM_PAG_SIZE-1)&~(MEM_PAG_SIZE-1);
  arm_heap_start=img_end;
  arm_heap_end=img_end;
  for (i=0;i<cnt;i++) {
    if (m20[i].base<=arm64_load_base<m20[i].base+m20[i].len)
      arm_heap_end=m20[i].base+m20[i].len;
    top=MaxI64(top,m20[i].base+m20[i].len);
  }
  mem_physical_space=top;
  mem_page_size=1<<30;	//The boot identity map uses 1 GiB blocks
  mem_mapped_space=1<<39; //and covers 39-bit addresses.
  mem_heap_base=arm_heap_start;

  sys_code_bp=&arm64_sys_fixed.sys_code_bp;
  sys_data_bp=NULL;
  bp=sys_code_bp;
  m=arm_heap_start;
  i=MinI64(ARM_BOOT_HEAP_SIZE,arm_heap_end-arm_heap_start)>>MEM_PAG_BITS;
  MemSet(bp,0,sizeof(CBlkPool));
  BlkPoolAdd(bp,m,i);
  mem_heap_limit=m+i<<MEM_PAG_BITS-1;
  LBts(&sys_run_level,RLf_16MEG_SYS_CODE_BP);
}

U0 ArmMemRep()
{//Report RAM, like the x86 boot E820 map.
  CMemE820 *m20=MEM_E820;
  "RAM:";
  while (m20->type) {
    " %X-%X",m20->base,m20->base+m20->len-1;
    m20++;
  }
  "  total %d MiB, heap from %X\n",BIOSTotalMem>>20,arm_heap_start;
}
