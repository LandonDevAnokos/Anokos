//Anokos terminal.
//A full-screen, black and white text console drawn straight onto the
//VBE linear framebuffer at the display's native resolution.  It
//replaces the TempleOS window manager, wallpaper and DolDoc terminal
//windows.  Commands are TerryC, run by the stock compiler through
//$LK,"UserTaskCont",A="MN:UserTaskCont"$(); only the screen and the line editor are new.
//
//Note: inside TerryC source, a literal dollar sign is written as two.

#help_index "Anokos/Terminal"

#define TERM_HIST_MAX	64
#define TERM_LINE_MAX	1024
#define TERM_DOLLAR_MAX	512
#define TERM_FPS	30
#define TERM_BLINK	0.5
#define TERM_PRIORITY	0x50000000 //StdOut hook: after input filter, before raw

class CAnoTerm
{
  I64	cols,rows,		//Text grid in chars
	cx,cy,			//Cursor, cx==cols means wrap is pending
	top,			//Ring buffer: physical row shown at screen row 0
	lock,
	anchor_x,anchor_y,	//Start of line being edited
	drawn_cy,		//Screen row the cursor was last drawn on
	dollar_len,
	hist_cnt;
  U8	*chars;			//rows*cols, physical row order
  Bool	*dirty;			//Per physical row
  U32	*line_buf;		//One scan line of pixels
  U32	fg,bg;
  F64	last_draw,last_blink;
  CTask	*task,*pump_task;
  Bool	active,all_dirty,cursor_vis,in_dollar,was_dbg;
  U8	dollar[TERM_DOLLAR_MAX];
  U8	*hist[TERM_HIST_MAX];
};

public CAnoTerm term;

U0 TermLock()
{
  while (LBts(&term.lock,0))
    Yield;
}

U0 TermUnlock()
{
  LBtr(&term.lock,0);
}

I64 TermPhys(I64 y)
{//Screen row to physical row.
  return (term.top+y)%term.rows;
}

U8 *TermCell(I64 x,I64 y)
{
  return term.chars+TermPhys(y)*term.cols+x;
}

U0 TermDirty(I64 y)
{
  if (0<=y<term.rows)
    term.dirty[TermPhys(y)]=TRUE;
}

U0 TermDrawRow(I64 y)
{//Render one text row into the framebuffer.
  I64 x,i,j,k,s=vbe.scale,cw=FONT_WIDTH*vbe.scale,
	row_bytes=term.cols*cw*sizeof(U32);
  U8 *src=term.chars+TermPhys(y)*term.cols,bits,*dst;
  U32 *p,c;
  Bool cur=term.cursor_vis && term.cy==y && term.cx<term.cols;
  for (i=0;i<FONT_HEIGHT;i++) {
    p=term.line_buf;
    for (x=0;x<term.cols;x++) {
      bits=text.font[src[x]].u8[i];
      if (cur && x==term.cx)
	bits=~bits;
      if (!bits) {
	MemSetU32(p,term.bg,cw);
	p+=cw;
      } else if (bits==0xFF) {
	MemSetU32(p,term.fg,cw);
	p+=cw;
      } else
	for (j=0;j<FONT_WIDTH;j++) {
	  if (Bt(&bits,j))
	    c=term.fg;
	  else
	    c=term.bg;
	  if (s==1)
	    *p++=c;
	  else {
	    MemSetU32(p,c,s);
	    p+=s;
	  }
	}
    }
    dst=vbe.fb(U8 *)+(y*FONT_HEIGHT*s+i*s)*vbe.pitch;
    for (k=0;k<s;k++) {
      MemCpy(dst,term.line_buf,row_bytes);
      dst+=vbe.pitch;
    }
  }
}

U0 TermRender()
{//Draw rows that changed. Call with lock held.
  I64 y;
  if (term.drawn_cy!=term.cy) {
    TermDirty(term.drawn_cy);
    TermDirty(term.cy);
  }
  for (y=0;y<term.rows;y++)
    if (term.all_dirty || term.dirty[TermPhys(y)]) {
      TermDrawRow(y);
      term.dirty[TermPhys(y)]=FALSE;
    }
  term.all_dirty=FALSE;
  term.drawn_cy=term.cy;
  term.last_draw=tS;
}

U0 TermMaybeRender()
{//Redraw at most TERM_FPS times a second while output is streaming.
//The pump task flushes the rest as soon as the printing task yields.
  if (tS-term.last_draw>1.0/TERM_FPS)
    TermRender;
}

U0 TermClsNoLock()
{
  MemSet(term.chars,CH_SPACE,term.rows*term.cols);
  term.top=0;
  term.cx=term.cy=0;
  term.anchor_x=term.anchor_y=0;
  term.all_dirty=TRUE;
}

public U0 Cls()
{//Clear the Anokos terminal.
  TermLock;
  TermClsNoLock;
  TermRender;
  TermUnlock;
}

U0 TermScroll()
{
  MemSet(term.chars+term.top*term.cols,CH_SPACE,term.cols);
  term.top=(term.top+1)%term.rows;
  term.anchor_y--;
  term.all_dirty=TRUE;
}

U0 TermNewLine()
{
  TermDirty(term.cy);
  term.cx=0;
  if (++term.cy>=term.rows) {
    TermScroll;
    term.cy=term.rows-1;
  }
}

U0 TermRawChar(U8 ch)
{//Put a glyph at the cursor and advance.
  if (term.cx>=term.cols)
    TermNewLine;
  *TermCell(term.cx,term.cy)=ch;
  TermDirty(term.cy);
  term.cx++;
#ifdef ARCH_ARM64
  ArmSerPutChar(ch); //The serial console shows the terminal's output too.
#endif
}

U0 TermDollarCmd(U8 *cmd)
{//DolDoc command: show the text of links and text widgets, drop the rest.
  U8 code[3],*ptr;
  if (!*cmd) {
    TermRawChar('$$');
    return;
  }
  code[0]=ToUpper(cmd[0]);
  code[1]=ToUpper(cmd[1]);
  code[2]=0;
  if (!StrCmp(code,"CL")) {
    TermClsNoLock;
    return;
  }
  if (LstMatch(code,"TX\0LK\0MA\0MU\0BT\0CB\0LS\0DA\0TR\0CK\0")<0)
    return;
  if (!(ptr=StrFirstOcc(cmd,"\"")))
    return;
  ptr++;
  while (*ptr && *ptr!='"') {
    if (*ptr=='\\' && ptr[1]=='n') {
      TermNewLine;
      ptr+=2;
    } else {
      if (*ptr=='\\' && ptr[1])
	ptr++;
      TermRawChar(*ptr++);
    }
  }
}

U0 TermPutChar(I64 ch)
{//Output one char. Call with lock held.
  ch&=255;
  if (term.in_dollar) {
    if (ch=='$$') {
      term.dollar[term.dollar_len]=0;
      term.in_dollar=FALSE;
      TermDollarCmd(term.dollar);
    } else if (term.dollar_len<TERM_DOLLAR_MAX-1)
      term.dollar[term.dollar_len++]=ch;
    return;
  }
  switch (ch) {
    case '$$':
      term.in_dollar=TRUE;
      term.dollar_len=0;
      break;
    case '\n':
      TermNewLine;
#ifdef ARCH_ARM64
      ArmSerPutChar(ch);
#endif
      break;
    case '\r':
      term.cx=0;
#ifdef ARCH_ARM64
      ArmSerPutChar(ch);
#endif
      break;
    case '\t':
      do TermRawChar(CH_SPACE);
      while (term.cx&7 && term.cx<term.cols);
      break;
    case CH_BACKSPACE:
      if (term.cx>0) {
	term.cx--;
	*TermCell(term.cx,term.cy)=CH_SPACE;
	TermDirty(term.cy);
      }
      break;
    default:
      if (ch>=CH_SPACE || Bt(char_bmp_displayable,ch))
	TermRawChar(ch);
  }
}

Bool TermOwnsOutput()
{//Debugger output stays on the raw kernel console.
  return term.active && !IsDbgMode;
}

Bool AnoTermPutKey(I64 ch,I64 sc)
{
  no_warn sc;
  if (!TermOwnsOutput)
    return FALSE;
  if (ch) {
    TermLock;
    TermPutChar(ch);
    TermMaybeRender;
    TermUnlock;
  }
  return TRUE;
}

Bool AnoTermPutS(U8 *st)
{
  if (!TermOwnsOutput)
    return FALSE;
  TermLock;
  while (*st)
    TermPutChar(*st++);
  TermMaybeRender;
  TermUnlock;
  return TRUE;
}

//***** Line editor, used for every GetStr() and the command line *****

U0 TermEditDraw(U8 *buf,I64 len,I64 pos,I64 erase)
{//Redraw the edited line from its anchor. Call with lock held.
  I64 i,x=term.anchor_x,y=term.anchor_y,p;
  for (i=0;i<len+erase;i++) {
    if (x>=term.cols) {
      x=0;
      if (++y>=term.rows) {
	TermScroll;
	y--;
      }
    }
    if (y>=0) {
      if (i<len)
	*TermCell(x,y)=buf[i];
      else
	*TermCell(x,y)=CH_SPACE;
      TermDirty(y);
    }
    x++;
  }
  p=term.anchor_x+pos;
  term.cy=term.anchor_y+p/term.cols;
  term.cx=p%term.cols;
  while (term.cy>=term.rows) {
    TermScroll;
    term.cy--;
  }
  term.cursor_vis=TRUE;
  term.last_blink=tS;
  TermRender;
}

U0 TermHistAdd(U8 *st)
{
  I64 i;
  if (!*st || term.hist_cnt && !StrCmp(term.hist[term.hist_cnt-1],st))
    return;
  if (term.hist_cnt==TERM_HIST_MAX) {
    Free(term.hist[0]);
    for (i=1;i<TERM_HIST_MAX;i++)
      term.hist[i-1]=term.hist[i];
    term.hist_cnt--;
  }
  term.hist[term.hist_cnt++]=StrNew(st,adam_task);
}

#ifdef ARCH_ARM64
U0 TermSerEdit(U8 *buf,I64 len,I64 pos,Bool start=FALSE)
{//Show the line being edited on the serial console too (VT100: save
//the cursor at the start, then redraw from there).
  I64 i;
  ArmSerPutChar(CH_ESC);
  if (start) {
    ArmSerPutChar('7');
    return;
  }
  ArmSerPutChar('8');
  for (i=0;i<len;i++)
    ArmSerPutChar(buf[i]);
  ArmSerPutChar(CH_ESC);
  ArmSerPutS("[K");
  if (pos<len) {
    ArmSerPutChar(CH_ESC);
    ArmSerPutChar('[');
    ArmSerPutDec(len-pos);
    ArmSerPutChar('D');
  }
}
#endif

U8 *AnoGetStr2(I64 flags=0)
{//Replaces the DolDoc line editor. Returns a MAlloc()ed string.
  U8 buf[TERM_LINE_MAX];
  I64 i,ch,sc,len=0,pos=0,old_len,hist_i=term.hist_cnt;
  no_warn flags;
  buf[0]=0;
  TermLock;
  if (term.cx>=term.cols)
    TermNewLine;
  term.anchor_x=term.cx;
  term.anchor_y=term.cy;
  TermEditDraw(buf,0,0,0);
  TermUnlock;
#ifdef ARCH_ARM64
  TermSerEdit(buf,0,0,TRUE);
#endif
  while (TRUE) {
    ch=GetKey(&sc);
    old_len=len;
    switch (sc.u8[0]) {
      case SC_CURSOR_LEFT:
	if (pos>0) pos--;
	goto ge_draw;
      case SC_CURSOR_RIGHT:
	if (pos<len) pos++;
	goto ge_draw;
      case SC_HOME:
	pos=0;
	goto ge_draw;
      case SC_END:
	pos=len;
	goto ge_draw;
      case SC_DELETE:
	if (pos<len) {
	  MemCpy(buf+pos,buf+pos+1,len-pos);
	  len--;
	}
	goto ge_draw;
      case SC_CURSOR_UP:
	if (hist_i>0) {
	  hist_i--;
	  StrCpy(buf,term.hist[hist_i]);
	  len=pos=StrLen(buf);
	}
	goto ge_draw;
      case SC_CURSOR_DOWN:
	if (hist_i<term.hist_cnt) {
	  hist_i++;
	  if (hist_i<term.hist_cnt)
	    StrCpy(buf,term.hist[hist_i]);
	  else
	    *buf=0;
	  len=pos=StrLen(buf);
	}
	goto ge_draw;
    }
    switch (ch) {
      case '\n':
	TermLock;
	TermEditDraw(buf,len,len,0);
	TermNewLine;
	TermRender;
	TermUnlock;
	TermHistAdd(buf);
#ifdef ARCH_ARM64
	TermSerEdit(buf,len,len);
	ArmSerPutChar('\n');
#endif
	return StrNew(buf);
      case CH_BACKSPACE:
	if (pos>0) {
	  MemCpy(buf+pos-1,buf+pos,len-pos+1);
	  pos--;
	  len--;
	}
	break;
      case CH_ESC:
      case CH_CTRLU:
	len=pos=0;
	*buf=0;
	break;
      case CH_CTRLL:
	TermLock;
	TermClsNoLock;
	TermEditDraw(buf,len,pos,0);
	TermUnlock;
	break;
      case '\t':
	ch=CH_SPACE;
      default:
	if (CH_SPACE<=ch<=0x7E && len<TERM_LINE_MAX-1) {
	  for (i=len;i>=pos;i--) //Not MemCpy(): it copies forward
	    buf[i+1]=buf[i];
	  buf[pos++]=ch;
	  len++;
	}
    }
ge_draw:
    TermLock;
    TermEditDraw(buf,len,pos,MaxI64(0,old_len-len));
    TermUnlock;
#ifdef ARCH_ARM64
    TermSerEdit(buf,len,pos);
#endif
  }
}

//***** Tasks *****

U0 AnoTermPumpTask(I64)
{//Feeds the keyboard to the focus task, blinks the cursor, flushes output.
  Bool dbg;
  while (TRUE) {
    KbdMsHndlr(FALSE,FALSE);
    if (!TaskValidate(sys_focus_task) && TaskValidate(term.task))
      sys_focus_task=term.task;
    KbdMsgsQue;
    dbg=IsDbgMode;
    if (!dbg) {
      TermLock;
      if (term.was_dbg)
	term.all_dirty=TRUE; //Debugger drew over us
      if (tS-term.last_blink>TERM_BLINK) {
	term.cursor_vis=!term.cursor_vis;
	term.last_blink=tS;
	TermDirty(term.cy);
      }
      TermRender;
      TermUnlock;
    }
    term.was_dbg=dbg;
    Sleep(15);
  }
}

U0 AnoTermTask(I64)
{//The shell: the stock TerryC command line on the Anokos screen.
  Fs->win_inhibit=WIG_USER_TASK_DFT; //Clears WIf_SELF_FOCUS so Ctrl+Alt+C works
  LBts(&Fs->display_flags,DISPLAYf_NOT_RAW);
  sys_focus_task=Fs;
#ifdef ARCH_ARM64
//No compiler on ARM64 yet, so no TerryC command line: built-in commands.
  "Anokos ARM64 (based on TempleOS V%5.3f)\n",sys_os_version;
  "Display %dx%d, %dx%d text. Help; lists the commands.\n\n",
	vbe.width,vbe.height,term.cols,term.rows;
  ArmShell;
#else
  Cd("~");
  "Anokos (based on TempleOS V%5.3f)\n",sys_os_version;
  "Display %dx%d, %dx%d text. Commands are TerryC, e.g. Dir;\n",
	vbe.width,vbe.height,term.cols,term.rows;
  "Ctrl+Alt+C stops a running command. Cls; clears the screen.\n\n";
  while (TRUE)
    UserTaskCont;
#endif
}

U0 AnoNop(I64)
{
}

public U0 AnoTermStart()
{//Take over the screen and start the terminal. Needs a VBE framebuffer.
  if (!Bt(&sys_run_level,RLf_VBE))
    return;
  MemSet(&term,0,sizeof(CAnoTerm)); //JIT globals are not zeroed
  term.cols=vbe.cols;
  term.rows=vbe.rows;
  term.chars=CAlloc(term.cols*term.rows);
  term.dirty=CAlloc(term.rows*sizeof(Bool));
  term.line_buf=CAlloc(vbe.width*sizeof(U32));
  term.fg=0xFFFFFF;
  term.bg=0x000000;
  term.cursor_vis=TRUE;
  TermClsNoLock;
  TermRender;
  term.active=TRUE;
  fp_getstr2=&AnoGetStr2;
  KeyDevAdd(&AnoTermPutKey,&AnoTermPutS,TERM_PRIORITY,FALSE);
  CtrlAltCBSet('T',&AnoNop,"Cmd/(no windows in Anokos)");
  term.pump_task=Spawn(&AnoTermPumpTask,NULL,"Term Pump");
  term.task=Spawn(&AnoTermTask,NULL,"Terminal");
}
